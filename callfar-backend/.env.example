# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1

# Security & CORS
CORS_ORIGIN=*
JWT_ACCESS_SECRET=callfar_super_secure_access_secret_change_in_production_key_2026
JWT_REFRESH_SECRET=callfar_super_secure_refresh_secret_change_in_production_key_2026
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION_DAYS=30

# Database Configuration (PostgreSQL / Supabase)
# For Local PostgreSQL:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/callfar?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/callfar?schema=public"

# For Supabase Cloud Database:
# 1. DATABASE_URL (Transaction Pooler - port 6543):
#    postgresql://postgres.[PROJECT_REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
# 2. DIRECT_URL (Session / Direct Connection - port 5432):
#    postgresql://postgres.[PROJECT_REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# Supabase Project Credentials (Optional for Storage & Client SDK)
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# WebRTC STUN/TURN Configuration (comma separated STUN URLs)
STUN_SERVERS="stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302,stun:stun.cloudflare.com:3478"
TURN_SERVER_URL=
TURN_SERVER_USERNAME=
TURN_SERVER_CREDENTIAL=

# Email & Password Reset (SMTP - Optional, automatically uses local test preview if omitted)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM="CallFar Security <noreply@callfar.app>"
APP_URL=http://localhost:5000
